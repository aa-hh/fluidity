#!/bin/sh
# Pre-push: refuses any push to main. The full suite runs on GitHub (the
# `tests` workflow), and main moves only through a pull request that the
# ruleset lets in once `tests` and `review` are green.
#
# Override once: git push --no-verify

zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a delete
    if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_PUSH_MAIN:-0}" != 1 ]; then
        echo "" >&2
        echo "  REFUSED: push to main. Open a pull request; it lands with gh pr merge --merge --auto." >&2
        echo "" >&2
        exit 1
    fi
done
exit 0
